---
import Base from "../layouts/Base.astro";
import { Mail, MapPin } from "@lucide/astro";
import { resume } from "../lib/info";
---

<Base
  title={`Contact - ${resume.name}`}
  description={`Hubungi ${resume.name}, mahasiswa Statistika Universitas Cenderawasih.`}
>
  <section class="container mx-auto px-6 pt-16 pb-20">
    <div class="max-w-3xl mx-auto">

      <p data-i18n="contactLabel" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
        Contact
      </p>

      <h1 data-i18n="contactTitle" class="mb-6 text-4xl md:text-5xl font-bold tracking-tight">
        Hubungi Saya
      </h1>

      <p data-i18n="contactDescription" class="text-base md:text-lg text-foreground/85 leading-relaxed mb-10">
        Saya terbuka untuk terhubung, berbagi ide, berdiskusi,
        serta menjajaki kesempatan belajar dan kolaborasi.
        Silakan menghubungi saya melalui platform berikut.
      </p>

      <div class="space-y-4">

        <a
          href="mailto:aprilianikenkalan28@gmail.com"
          class="flex items-center gap-4 p-5 border border-border/60 rounded-md bg-card hover:border-primary/50 transition-colors"
        >
          <Mail size={22} class="text-muted-foreground shrink-0" />
          <div class="min-w-0">
            <h2 class="text-sm font-semibold mb-1">Email</h2>
            <p class="text-sm text-muted-foreground break-all">
              aprilianikenkalan28@gmail.com
            </p>
          </div>
        </a>

        <a
          href="https://www.instagram.com/ll1kaaa_/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-5 border border-border/60 rounded-md bg-card hover:border-primary/50 transition-colors"
        >
          <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-pink-500 shrink-0" aria-label="Instagram" role="img">
  <rect x="3" y="3" width="18" height="18" rx="5"/>
  <circle cx="12" cy="12" r="4"/>
  <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
</svg>
          <div>
            <h2 class="text-sm font-semibold mb-1">Instagram</h2>
            <p class="text-sm text-muted-foreground">
              @ll1kaaa_
            </p>
          </div>
        </a>

        <a
          href="https://github.com/aprilianikenkalan28"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-5 border border-border/60 rounded-md bg-card hover:border-primary/50 transition-colors"
        >
          <svg width="23" height="23" viewBox="0 0 24 24" fill="currentColor" class="text-foreground shrink-0" aria-label="GitHub" role="img">
  <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.92.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.06 1.15a10.6 10.6 0 0 1 5.57 0c2.12-1.45 3.06-1.15 3.06-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.29-2.61 5.24-5.1 5.52.4.35.75 1.03.75 2.08v3.06c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/>
</svg>
          <div>
            <h2 class="text-sm font-semibold mb-1">GitHub</h2>
            <p class="text-sm text-muted-foreground">
              aprilianikenkalan28
            </p>
          </div>
        </a>

        <div class="flex items-center gap-4 p-5 border border-border/60 rounded-md bg-card">
          <MapPin size={22} class="text-muted-foreground shrink-0" />
          <div>
            <h2 data-i18n="location" class="text-sm font-semibold mb-1">Location</h2>
            <p class="text-sm text-muted-foreground">
              Jayapura, Papua, Indonesia
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</Base>





