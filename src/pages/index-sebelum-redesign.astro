---
import Base from "../layouts/Base.astro";
import siteInfo from "../../public/0user.json";
---

<Base title={siteInfo.site.title} description={siteInfo.site.description}>
  <section class="home-hero">
    <div class="hero-content">
      <div class="hero-photo-wrap">
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>
        <div class="hero-photo-frame">
          <img
            src="/images/profile.jpg"
            alt="Foto profil Aprilia Niken Kalan"
            class="hero-photo"
            loading="eager"
          />
        </div>
        <div class="photo-status">
          <span class="status-dot"></span>
          STATISTICS STUDENT
        </div>
      </div>

      <div class="hero-text">
        <p class="hero-label">HELLO, WORLD! I'M</p>

        <h1>{siteInfo.name}</h1>

        <p class="hero-role" data-i18n="homeRole">
          {siteInfo.role}
        </p>

        <div class="hero-line"></div>

        <p class="hero-bio" data-i18n="homeBio">
          {siteInfo.home.bio}
        </p>

        <p class="hero-note" data-i18n="homeNote">
          {siteInfo.home.note}
        </p>

        <div class="hero-contacts">
          {siteInfo.contacts.map((contact) => (
            <a
              href={contact.href}
              target={contact.target}
              rel={contact.rel}
              class="hero-contact"
            >
              <span data-i18n={contact.label.toLowerCase()}>
                {contact.label}
              </span>
              <span class="contact-arrow">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="hero-decoration">PORTFOLIO / 2026</div>
  </section>

  <style>
    .home-hero {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
      min-height: 75vh;
      padding: 70px 7%;
      overflow: hidden;
      isolation: isolate;
    }

    .home-hero::before {
      content: "";
      position: absolute;
      width: 450px;
      height: 450px;
      left: 8%;
      top: 12%;
      background: #9b4dff;
      opacity: .10;
      filter: blur(120px);
      border-radius: 50%;
      z-index: -1;
    }

    .home-hero::after {
      content: "";
      position: absolute;
      width: 400px;
      height: 400px;
      right: 5%;
      bottom: 5%;
      background: #00cfff;
      opacity: .09;
      filter: blur(120px);
      border-radius: 50%;
      z-index: -1;
    }

    .hero-content {
      width: 100%;
      max-width: 1150px;
      display: grid;
      grid-template-columns: minmax(260px, .85fr) 1.3fr;
      align-items: center;
      gap: clamp(40px, 8vw, 100px);
    }

    .hero-photo-wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 25px;
      animation: heroFloat 5s ease-in-out infinite;
    }

    .hero-photo-frame {
      position: relative;
      width: min(100%, 340px);
      aspect-ratio: 1;
      padding: 7px;
      border-radius: 50%;
      background: linear-gradient(135deg, #a855f7, #00d4ff, #a855f7);
      box-shadow: 0 0 25px #a855f755, 0 0 65px #00d4ff22;
      animation: heroGlow 4s ease-in-out infinite alternate;
    }

    .hero-photo {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center;
      border-radius: 50%;
      border: 5px solid #111116;
    }

    .hero-orbit {
      position: absolute;
      border: 1px solid #a855f766;
      border-radius: 50%;
      pointer-events: none;
    }

    .orbit-one {
      width: 390px;
      height: 390px;
      animation: orbitSpin 15s linear infinite;
    }

    .orbit-two {
      width: 425px;
      height: 425px;
      border-color: #00d4ff55;
      animation: orbitSpin 22s linear infinite reverse;
    }

    .photo-status {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 10px 17px;
      border: 1px solid #ffffff22;
      background: #15151b;
      border-radius: 30px;
      font-size: 11px;
      letter-spacing: 2px;
      font-weight: 700;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background: #00e5a0;
      border-radius: 50%;
      box-shadow: 0 0 12px #00e5a0;
    }

    .hero-label {
      color: #ae82ff;
      font-size: 14px;
      letter-spacing: 4px;
      font-weight: 700;
      margin-bottom: 15px;
    }

    .hero-text h1 {
      font-size: clamp(36px, 5vw, 65px);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -2px;
      overflow-wrap: anywhere;
      background: linear-gradient(100deg, #fff, #c9a5ff, #72dfff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-role {
      font-size: clamp(17px, 2vw, 22px);
      color: #b18aff;
      margin-top: 15px;
      font-weight: 600;
    }

    .hero-line {
      width: 85px;
      height: 4px;
      margin: 25px 0;
      border-radius: 10px;
      background: linear-gradient(90deg, #a855f7, #00d4ff);
      box-shadow: 0 0 15px #a855f799;
    }

    .hero-bio, .hero-note {
      color: #aaa9b4;
      font-size: 15px;
      line-height: 1.9;
      margin-bottom: 15px;
    }

    .hero-contacts {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .hero-contact {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 17px;
      border: 1px solid #ffffff22;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 600;
      transition: .3s ease;
    }

    .hero-contact:hover {
      border-color: #a855f7;
      background: #a855f71c;
      transform: translateY(-4px);
      box-shadow: 0 0 20px #a855f733;
    }

    .contact-arrow {
      color: #a855f7;
    }

    .hero-decoration {
      position: absolute;
      right: 35px;
      bottom: 25px;
      color: #777;
      font-size: 10px;
      letter-spacing: 3px;
    }

    @keyframes heroFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-13px); }
    }

    @keyframes heroGlow {
      from { box-shadow: 0 0 20px #a855f755, 0 0 40px #00d4ff22; }
      to { box-shadow: 0 0 35px #a855f799, 0 0 75px #00d4ff55; }
    }

    @keyframes orbitSpin {
      to { transform: rotate(360deg); }
    }

    @media (max-width: 760px) {
      .home-hero {
        padding: 55px 22px;
      }

      .hero-content {
        grid-template-columns: 1fr;
        gap: 55px;
      }

      .hero-photo-frame {
        width: min(68vw, 270px);
      }

      .orbit-one {
        width: min(78vw, 310px);
        height: min(78vw, 310px);
      }

      .orbit-two {
        width: min(86vw, 340px);
        height: min(86vw, 340px);
      }

      .hero-text {
        text-align: center;
      }

      .hero-line {
        margin: 22px auto;
      }

      .hero-contacts {
        justify-content: center;
      }

      .hero-decoration {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-photo-wrap, .hero-photo-frame, .hero-orbit {
        animation: none;
      }
    }
  </style>
</Base>
