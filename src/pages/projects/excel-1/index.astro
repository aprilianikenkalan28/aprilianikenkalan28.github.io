---
import Base from "../../../layouts/Base.astro";
---

<Base
  title="Proyek Excel 1 - Aprilia Niken Kalan"
  description="Hasil praktik perhitungan modal dan keuntungan menggunakan Microsoft Excel."
>
  <main class="max-w-4xl mx-auto px-6 py-12">

    <h1 class="text-3xl font-bold mb-4">
      Perhitungan Modal dan Keuntungan Menggunakan Microsoft Excel
    </h1>

    <p class="text-gray-600 mb-8">
      Proyek ini merupakan hasil praktik pembelajaran Microsoft Excel
      dalam menghitung modal, harga jual, dan keuntungan.
    </p>

    <div class="border rounded-xl p-6">
      <h2 class="text-xl font-semibold mb-3">
        File Proyek
      </h2>

      <p class="text-gray-600 mb-5">
        Silakan buka file Excel berikut untuk melihat hasil pekerjaan.
      </p>

      <a
        href="/projects/excel/hasil-excel.xlsx" download

        class="inline-block px-5 py-3 rounded-lg bg-black text-white hover:opacity-80"
      >
        Buka File Excel 1 â†’
      </a>
    </div>

  </main>
</Base>

