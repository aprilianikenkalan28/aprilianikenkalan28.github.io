---
import Base from "../../layouts/Base.astro";

const projects = [
  {
    number: "01",
    title: "Pengolahan Data Menggunakan Microsoft Excel",
    category: "Microsoft Excel",
    description:
      "Penerapan rumus dan fitur Excel untuk membantu proses pengolahan serta pengelolaan data.",
    href: "/projects/excel-1/",
  },
  {
    number: "02",
    title: "Perhitungan Modal dan Keuntungan",
    category: "Microsoft Excel",
    description:
      "Penggunaan Microsoft Excel untuk menyusun perhitungan modal, pendapatan, dan keuntungan.",
    href: "/projects/excel-2/",
  },
  {
    number: "03",
    title: "Operasi Gabungan Menggunakan Python",
    category: "Python",
    description:
      "Penerapan dasar pemrograman Python dalam tugas Algoritma dan Pemrograman.",
    href: "/projects/python/",
  },
];
---

<Base
  title="Projects - Aprilia Niken Kalan"
  description="Kumpulan proyek pembelajaran Aprilia Niken Kalan."
>
  <main class="container mx-auto px-6 py-16">
    <div class="mx-auto max-w-4xl">

      <p class="text-sm text-accent" data-i18n="projectsLabel">PORTFOLIO</p>

      <h1 class="mt-3 text-4xl font-semibold" data-i18n="projectsTitle">Projects</h1>

      <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">
        Berikut beberapa proyek dan tugas yang saya kerjakan
        selama proses pembelajaran sebagai mahasiswa Statistika.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">

        {projects.map((project) => (
          <article
            class="rounded-xl border border-border p-6 transition-colors hover:border-accent"
          >
            <p class="text-sm text-accent">
              <span data-i18n="projectLabel">PROJECT</span> {project.number}
            </p>

            <h2 class="mt-4 text-xl font-semibold" data-i18n={project.number === "01" ? "project1Title" : project.number === "02" ? "project2Title" : "project3Title"}>
              {project.title}
            </h2>

            <p class="mt-3 text-sm text-muted-foreground" data-i18n={project.number === "01" ? "project1Description" : project.number === "02" ? "project2Description" : "project3Description"}>
              {project.description}
            </p>

            <div class="mt-5 flex items-center justify-between">
              <span class="text-xs text-muted-foreground">
                {project.category}
              </span>

              <a
                href={project.href}
                class="group inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-semibold transition-all duration-300 hover:border-purple-500 hover:bg-purple-500/10 hover:text-purple-400 hover:shadow-[0_0_18px_rgba(168,85,247,0.35)]"
              >
                Lihat Proyek
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">
                  <path d="M7 17 17 7"/>
                  <path d="M7 7h10v10"/>
                </svg>
              </a>
            </div>
          </article>
        ))}

      </div>
    </div>
  </main>
</Base>




