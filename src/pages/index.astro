---
import Base from "../layouts/Base.astro";
import { ArrowUpRight } from "@lucide/astro";
import siteInfo from "../../public/0user.json";
---

<Base title={siteInfo.site.title} description={siteInfo.site.description}>
  <section class="profile-hero">
    <div class="hero-inner">

      <div class="hero-copy">
        <div class="hero-tag">
          <span class="live-dot"></span>
          PERSONAL PORTFOLIO
        </div>

        <p class="eyebrow">HELLO, WORLD! I'M</p>

        <h1>{siteInfo.name}</h1>

        <p class="hero-role" data-i18n="homeRole">
          {siteInfo.role}
        </p>

        <div class="gradient-line"></div>

        <p class="hero-bio" data-i18n="homeBio">
          {siteInfo.home.bio}
        </p>

        <p class="hero-note" data-i18n="homeNote">
          {siteInfo.home.note}
        </p>

        <div class="hero-buttons">
          <a href="/about/" class="btn-primary">
            About Me <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          <a href="/projects/" class="btn-secondary">
            <span class="grid-icon">▦</span> My Projects
          </a>
        </div>

        <div class="hero-socials">
          {siteInfo.contacts.map((contact) => (
            <a href={contact.href}
              target={contact.target}
              rel={contact.rel}>
              {contact.label}
            </a>
          ))}
        </div>
      </div>

      <div class="hero-visual">
        <div class="photo-aura"></div>
        <div class="photo-card">
          <div class="photo-topline">
            <span>PROFILE / 001</span>
            <span class="photo-status">● ONLINE</span>
          </div>

          <img
            src="/images/profile.jpg"
            alt="Foto profil"
            class="profile-photo"
            loading="eager"
          />

          <div class="photo-caption">
            <span>{siteInfo.name}</span>
            <span>✦</span>
          </div>
        </div>
        <div class="floating-label">CREATIVE · CURIOUS · ANALYTICAL</div>
      </div>

    </div>
    <div class="hero-background-text">PORTFOLIO</div>
  </section>

  <style>
    .profile-hero {
      position: relative;
      flex: 1;
      min-height: 78vh;
      display: flex;
      align-items: center;
      padding: 65px 6%;
      overflow: hidden;
      isolation: isolate;
    }

    .profile-hero::before {
      content: "";
      position: absolute;
      width: 480px;
      height: 480px;
      top: 5%;
      right: 5%;
      background: #8b35ff;
      filter: blur(150px);
      opacity: .15;
      z-index: -1;
    }

    .profile-hero::after {
      content: "";
      position: absolute;
      width: 350px;
      height: 350px;
      bottom: 0;
      left: 0;
      background: #00cfff;
      filter: blur(140px);
      opacity: .10;
      z-index: -1;
    }

    .hero-inner {
      width: 100%;
      max-width: 1250px;
      margin: auto;
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      align-items: center;
      gap: 65px;
      z-index: 1;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 15px;
      border: 1px solid #ffffff20;
      border-radius: 8px;
      background: #ffffff08;
      color: #c5b3e9;
      font: 12px monospace;
      letter-spacing: 2px;
      margin-bottom: 35px;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      background: #00e6a0;
      border-radius: 50%;
      box-shadow: 0 0 12px #00e6a0;
    }

    .eyebrow {
      color: #b78aff;
      font: 700 13px monospace;
      letter-spacing: 4px;
      margin-bottom: 14px;
    }

    .hero-copy h1 {
      font-size: clamp(42px, 5.5vw, 76px);
      line-height: 1.05;
      font-weight: 800;
      letter-spacing: -3px;
      overflow-wrap: anywhere;
      background: linear-gradient(100deg, #fff 20%, #c49aff 65%, #65ddff);
      color: transparent;
      background-clip: text;
      -webkit-background-clip: text;
    }

    .hero-role {
      color: #b995ff;
      font-size: clamp(17px, 2vw, 23px);
      margin-top: 22px;
      font-weight: 600;
    }

    .gradient-line {
      width: 100px;
      height: 4px;
      border-radius: 10px;
      background: linear-gradient(90deg, #a855f7, #00d4ff);
      margin: 28px 0;
      box-shadow: 0 0 18px #a855f766;
    }

    .hero-bio, .hero-note {
      color: #aaa9b5;
      font-size: 15px;
      line-height: 1.9;
      max-width: 580px;
      margin-bottom: 12px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 32px;
    }

    .btn-primary, .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      padding: 16px 23px;
      border-radius: 9px;
      font-family: monospace;
      font-size: 15px;
      font-weight: 700;
      transition: .3s ease;
    }

    .btn-primary {
      color: #100c19;
      background: linear-gradient(110deg, #c084fc, #8b5cf6);
      box-shadow: 0 0 20px #a855f744;
    }

    .btn-primary:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 35px #a855f799;
    }

    .btn-primary span {
      font-size: 22px;
    }

    .btn-secondary {
      border: 1px solid #ffffff40;
      color: #f5f1ff;
      background: #ffffff08;
    }

    .btn-secondary:hover {
      transform: translateY(-5px);
      border-color: #a855f7;
      background: #a855f722;
    }

    .grid-icon {
      font-size: 20px;
      color: #b995ff;
    }

    .hero-socials {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 35px;
    }

    .hero-socials a {
      color: #85838f;
      font-size: 12px;
      font-family: monospace;
      transition: .2s;
    }

    .hero-socials a:hover {
      color: #c084fc;
    }

    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 15px;
    }

    .photo-aura {
      position: absolute;
      width: 90%;
      height: 90%;
      background: linear-gradient(135deg, #a855f7, #00d4ff);
      filter: blur(85px);
      opacity: .22;
      border-radius: 50%;
      animation: auraPulse 4s ease-in-out infinite alternate;
    }

    .photo-card {
      position: relative;
      width: min(100%, 390px);
      padding: 13px;
      border: 1px solid #b78aff55;
      border-radius: 32px;
      background: #101014;
      box-shadow: 0 0 35px #a855f722, 0 25px 80px #0008;
      animation: photoFloat 5s ease-in-out infinite;
    }

    .photo-topline, .photo-caption {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 8px 14px;
      font: 10px monospace;
      letter-spacing: 2px;
      color: #aaa1bd;
    }

    .photo-status {
      color: #00e6a0;
    }

    .profile-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: center;
      display: block;
      border-radius: 23px;
      background: #1b1722;
    }

    .photo-caption {
      padding: 16px 8px 7px;
      font-size: 11px;
      color: #eee;
    }

    .photo-caption span:last-child {
      color: #b78aff;
      font-size: 18px;
    }

    .floating-label {
      position: absolute;
      bottom: 2%;
      right: -8%;
      padding: 12px 16px;
      background: #17151f;
      border: 1px solid #a855f766;
      border-radius: 8px;
      color: #c8a7ff;
      font: 10px monospace;
      letter-spacing: 1px;
      box-shadow: 0 0 25px #a855f733;
    }

    .hero-background-text {
      position: absolute;
      bottom: -45px;
      left: 2%;
      z-index: -1;
      color: #ffffff04;
      font-size: clamp(100px, 20vw, 260px);
      font-weight: 900;
      letter-spacing: -12px;
      pointer-events: none;
    }

    @keyframes photoFloat {
      0%, 100% { transform: translateY(0) rotate(0); }
      50% { transform: translateY(-12px) rotate(.5deg); }
    }

    @keyframes auraPulse {
      from { opacity: .12; transform: scale(.9); }
      to { opacity: .3; transform: scale(1.08); }
    }

    @media (max-width: 800px) {
      .profile-hero { padding: 50px 22px; }
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 55px;
      }
      .hero-copy { text-align: center; }
      .gradient-line { margin: 25px auto; }
      .hero-buttons, .hero-socials { justify-content: center; }
      .hero-visual { grid-row: 1; }
      .photo-card { width: min(78%, 330px); }
      .floating-label { right: -3%; }
      .hero-background-text { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .photo-card, .photo-aura { animation: none; }
    }
  </style>
</Base>
