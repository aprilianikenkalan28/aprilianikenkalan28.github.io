---
import Base from "../../layouts/Base.astro";
---

<Base
  title="About - Aprilia Niken Kalan"
  description="Profil akademik mahasiswa Statistika Universitas Cenderawasih."
>
  <section class="container mx-auto px-6 py-16">
    <div class="max-w-3xl mx-auto">

      <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3" data-i18n="aboutLabel">
        TENTANG SAYA
      </p>

      <h1 class="mb-6 text-4xl md:text-5xl font-bold tracking-tight" data-i18n="aboutTitle">
        Tentang Saya
      </h1>

      <p class="text-base md:text-lg text-foreground/85 leading-relaxed mb-10" data-i18n="aboutIntro">
        Saya adalah mahasiswa S1 Statistika di Universitas Cenderawasih. Saya memiliki ketertarikan pada pengolahan data, analisis data, visualisasi data, dan pemrograman. Saat ini, saya sedang mengembangkan pengetahuan dan keterampilan melalui pembelajaran akademik serta praktik secara mandiri.
      </p>

      <div class="mb-10">
        <h2 class="text-2xl font-semibold mb-5" data-i18n="education">Pendidikan</h2>

        <div class="border border-border rounded-xl p-5">
          <h3 class="font-semibold text-lg">S1 Statistika</h3>
          <p class="text-muted-foreground mt-1">Universitas Cenderawasih</p>
          <p class="text-sm text-muted-foreground mt-1">2026 - Sekarang</p>
          <p class="text-sm mt-3" data-i18n="educationDegree">Program Sarjana Statistika</p>
        </div>
      </div>

      <div class="mb-10">
        <h2 class="text-2xl font-semibold mb-5" data-i18n="skillsTitle">Bidang yang Dipelajari</h2>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="border border-border rounded-xl p-5">
            <h3 class="font-semibold">Microsoft Excel</h3>
            <ul class="mt-3 text-sm text-muted-foreground space-y-2">
              <li data-i18n="skillExcel1">Penggunaan rumus</li>
              <li data-i18n="skillExcel2">Pengolahan data</li>
              <li data-i18n="skillExcel3">Pembuatan tabel</li>
              <li data-i18n="skillExcel4">Pembuatan grafik</li>
            </ul>
          </div>

          <div class="border border-border rounded-xl p-5">
            <h3 class="font-semibold">Programming</h3>
            <ul class="mt-3 text-sm text-muted-foreground space-y-2">
              <li data-i18n="skillPython">Python (Pembelajaran)</li>
            </ul>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-4" data-i18n="learningGoals">Tujuan Pembelajaran</h2>
        <p class="text-base md:text-lg text-foreground/85 leading-relaxed" data-i18n="learningDescription">
          Saya ingin terus mengembangkan kemampuan dalam bidang statistika dan teknologi, khususnya dalam memahami, mengolah, menganalisis, serta menyajikan data sebagai informasi yang bermanfaat.
        </p>
      </div>

    </div>
  </section>
</Base>