---
const links = [
  { href: "/", label: "Beranda", key: "home" },
  { href: "/about/", label: "Tentang", key: "about" },
  { href: "/projects/", label: "Proyek", key: "projects" },
  { href: "/contact/", label: "Kontak", key: "contact" },
];

function isActiveHref(href: string) {
  return Astro.url.pathname === href;
}

function linkClass(href: string) {
  const active = isActiveHref(href);

  return `text-sm transition-colors duration-300 ${
    active
      ? "text-foreground font-semibold"
      : "text-muted-foreground hover:text-foreground"
  }`;
}
---

<nav class="sticky top-0 z-50 border-b border-border/50 bg-background/90 backdrop-blur-md">
  <div class="container mx-auto px-6">
    <div class="flex min-h-16 items-center justify-between gap-5 flex-wrap py-3">

      <!-- Navigasi sebelah kiri -->
      <div class="flex items-center gap-6 flex-wrap">
        {links.map((l) => (
          <a
            href={l.href}
            class={linkClass(l.href)}
            aria-current={isActiveHref(l.href) ? "page" : undefined}
          >
            <span data-i18n={l.key}>{l.label}</span>
          </a>
        ))}
      </div>

      <!-- Kontrol sebelah kanan -->
      <div class="flex items-center gap-3">

        <!-- Pilihan bahasa -->
        <div class="language-switcher" aria-label="Pilih bahasa">
          <button
            type="button"
            data-language-button="id"
            aria-pressed="true"
          >
            Indonesia
          </button>

          <button
            type="button"
            data-language-button="en"
            aria-pressed="false"
          >
            English
          </button>
        </div>

        <!-- Dark Mode -->
        <button
          id="theme-toggle"
          type="button"
          class="rounded-lg border border-border px-3 py-2 text-sm transition-all duration-300 hover:bg-secondary hover:-translate-y-0.5"
          aria-label="Ganti tema"
          title="Ganti tema"
        >
          <span id="theme-icon" aria-hidden="true">🌙</span>
        </button>

      </div>
    </div>
  </div>
</nav>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const themeIcon = document.getElementById("theme-icon");

  function updateThemeIcon() {
    const isDark = document.documentElement.classList.contains("dark");

    if (themeIcon) {
      themeIcon.textContent = isDark ? "☀️" : "🌙";
    }
  }

  updateThemeIcon();

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");

    localStorage.setItem("theme", isDark ? "dark" : "light");

    updateThemeIcon();
  });
</script>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
  }

  .language-switcher button {
    padding: 7px 12px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .language-switcher button:hover {
    color: var(--foreground);
    background: var(--secondary);
  }

  .language-switcher button[aria-pressed="true"] {
    color: var(--foreground);
    background: var(--secondary);
    border-color: var(--border);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .language-switcher button {
      padding: 6px 8px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-switcher button {
      transition: none;
    }
  }
</style>